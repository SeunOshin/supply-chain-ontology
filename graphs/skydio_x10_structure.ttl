data:link_item_modem_5g_telit a iof:SupplyRelationship ;
    rdfs:label "Telit Cinterion -> Built-in 5G/LTE cellular modem (FN990A40)" ;
    rdfs:comment "Skydio lists the FCC ID of Telit's FN990A40 5G module for the X10. In August 2025 Skydio registered its own ID (2ATQRA40) for a '5G NR Module' A40 as a change in identification, so later units may carry a Skydio label on the same module. Not a contract or exclusivity statement." ;
    prov:wasDerivedFrom <https://fcc.report/FCC-ID/RI7FN990A40/6842000.pdf>,
        <https://support.skydio.com/hc/en-us/articles/40739840785947-Skydio-Product-FCC-ID-IC-ID-Information>,
        <https://www.fccinsights.com/skydio-inc> ;
    iof:dependsOnProduct data:modem_5g ;
    iof:dependsOnSupplier data:sup_telit .

