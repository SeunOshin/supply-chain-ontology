data:site_origin_nidec_jp a iof:GeospatialLocation,
        iof:SupplyChainNode ;
    rdfs:label "Japan (alternative country of manufacture: Nidec drone motors)" ;
    bfo:BFO_0000171 data:country_JP ;
    rdfs:comment "Alternative to Thailand. The product contact in Nidec's Japanese release is its small motor business unit in Japan; Nidec Precision, another Nidec unit, also lists camera pan and tilt motors for drones. China is excluded because since 10 October 2024 organisations within China, including Chinese subsidiaries of foreign companies, may not transact with Skydio. Confidence: low." ;
    prov:wasAttributedTo data:researcher ;
    prov:wasDerivedFrom <https://digitalpr.jp/pdf.php?r=92070>,
        <https://us.china-embassy.gov.cn/eng/zmgxs/zxxx/202412/t20241219_11505708.htm>,
        <https://www.nidec.com/en/nidec-precision/product/search/app/A_B100/A_M103/> .

data:site_origin_nidec_th a iof:GeospatialLocation,
        iof:SupplyChainNode ;
    rdfs:label "Thailand (inferred country of manufacture: Nidec drone motors)" ;
    bfo:BFO_0000171 data:country_TH ;
    rdfs:comment "Nidec Electronics (Thailand), a Nidec motor manufacturer, lists brushless DC motors for industrial drones; no source ties the X10 motors to this plant. China is excluded because since 10 October 2024 organisations within China, including Chinese subsidiaries of foreign companies, may not transact with Skydio. Confidence: medium-low for the propulsion motors, low for the gimbal motors." ;
    prov:wasAttributedTo data:researcher ;
    prov:wasDerivedFrom <https://timewell.jp/en/columns/china-counter-sanctions-and-drone-export-control>,
        <https://us.china-embassy.gov.cn/eng/zmgxs/zxxx/202412/t20241219_11505708.htm>,
        <https://www.mfa.gov.cn/eng/xw/wjbxw/202410/t20241011_11505419.html>,
        <https://www.nidec.com/en/worldwide_new/factory/nidec_electronics_thailand_co_ltdrojana_factory/>,
        <https://www.nidec.com/en/worldwide_new/sales/nidec_electronics_thailand/> .

