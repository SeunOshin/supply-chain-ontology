data:link_item_battery_dongguan_poweramp a iof:SupplyRelationship ;
    rdfs:label "Historical: Dongguan Poweramp Technology -> Flight battery" ;
    rdfs:comment "Reported as Skydio's sole battery supplier until Chinese sanctions of 11 October 2024, after which it was reportedly ordered to stop supplying Skydio. Historical association; not current." ;
    prov:wasDerivedFrom <https://dronexl.co/2024/10/30/us-drone-maker-skydio-supply-chain-crisis-chinese-sanctions>,
        <https://pravda.com.ua/eng/news/2024/10/31/7482246> ;
    iof:dependsOnProduct data:battery ;
    iof:dependsOnSupplier data:sup_dongguan_poweramp .

