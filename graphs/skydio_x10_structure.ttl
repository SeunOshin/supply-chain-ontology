data:site_origin_sony_jp a iof:GeospatialLocation,
        iof:SupplyChainNode ;
    rdfs:label "Japan (inferred country of origin: Sony image sensors)" ;
    bfo:BFO_0000171 data:country_JP ;
    rdfs:comment "Sony makes image-sensor wafers at its Nagasaki, Yamagata and Kumamoto sites in Japan, and CBP treats an image sensor's origin as the wafer country. Sony outsources part of the process to foundries, so a layer may be made elsewhere. Confidence: medium." ;
    prov:wasAttributedTo data:researcher ;
    prov:wasDerivedFrom <https://rulings.cbp.gov/ruling/N306471>,
        <https://www.eenewseurope.com/en/sony-to-ramp-cmos-image-sensor-production/>,
        <https://www.photographyblog.com/news/sony_ups_production_capacity_for_stacked_cmos_sensors> .

