data:event_china_rare_earth_licensing_2025 a iof:Event ;
    rdfs:label "China imposes licensing on seven rare earth elements and magnets" ;
    dcterms:date "2025-04-04" ;
    rdfs:comment "On April 4, 2025, China's Ministry of Commerce required export licenses for seven medium and heavy rare earths and related magnets, answering US tariff increases. It also put 16 US entities, mostly defense and aerospace firms, on its export control list." ;
    prov:wasDerivedFrom <https://www.csis.org/analysis/consequences-chinas-new-rare-earths-export-restrictions> ;
    iof:classifiedBy data:eventscope_scope_all_trade_in_the_countries_or_goods,
        data:eventtype_export_controls ;
    iof:occursAt data:country_CN .

data:event_drc_cobalt_quotas_2025 a iof:Event ;
    rdfs:label "DRC replaces cobalt export suspension with quota system" ;
    dcterms:date "2025-09-20" ;
    rdfs:comment "On 20 September 2025 the DRC's mining regulator ARECOMS extended the cobalt export suspension to 15 October 2025. From 16 October it allowed exports only under monthly quotas: 96,600 tonnes for 2026, with the same cap planned for 2027." ;
    prov:wasDerivedFrom <https://www.iea.org/policies/29138-drc-arecoms-decision-no-0042025-cobalt-quota-system> ;
    iof:classifiedBy data:eventscope_scope_all_trade_in_the_countries_or_goods,
        data:eventtype_resource_nationalism ;
    iof:occursAt data:country_CD .

data:event_foxlink_tucheng_plant_fire_2026 a iof:Event ;
    rdfs:label "Fire breaks out at Foxlink's Tucheng plant in Taiwan" ;
    dcterms:date "2026-11-09" ;
    rdfs:comment "A fire broke out at Foxlink's plant in Tucheng, New Taipei City, at about 8 a.m. on 9 November 2026. The fire department sent multiple vehicles and personnel, and the company formed a crisis team. The visible text gives no damage or output details." ;
    prov:wasDerivedFrom <https://www.digitimes.com/news/a20261109PD234/fire-plant-taipei-personnel-investigation.html> ;
    iof:classifiedBy data:eventscope_scope_the_named_companies_only,
        data:eventtype_industrial_accident ;
    iof:occursAt data:country_TW .

