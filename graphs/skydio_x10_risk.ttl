data:event_hormuz_closure_2026 a iof:Event ;
    rdfs:label "Strait of Hormuz effectively closed amid US-Israel-Iran conflict, disrupting shipping and air cargo" ;
    dcterms:date "2026-02-28" ;
    rdfs:comment "After military strikes on 28 February 2026 involving the US, Israel and Iran, the Strait of Hormuz was effectively closed. Carriers suspended transits and rerouted, about 170 container ships were trapped, Jebel Ali was briefly suspended, air cargo capacity fell 18%, and Ras Tanura refinery shut." ;
    prov:wasDerivedFrom <https://ciltuk.org.uk/news/hormuz-closure-triggers-global-supply-chain-shock-as-oil-shipping-and-air-cargo-disrupted/> ;
    ns1:affects data:code_us_8542310070 ;
    iof:classifiedBy data:eventscope_scope_all_trade_in_the_countries_or_goods,
        data:eventtype_war_or_blockade ;
    iof:occursAt data:country_AE,
        data:country_IR,
        data:country_SA .

