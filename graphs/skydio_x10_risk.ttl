data:event_skydio_sanctions_2024 a iof:Event ;
    rdfs:label "China sanctions Skydio, cutting off its battery supplier Dongguan Poweramp" ;
    bfo:BFO_0000057 data:sup_dongguan_poweramp,
        data:sup_skydio ;
    dcterms:date "2024-10-11" ;
    rdfs:comment "On 11 October 2024 China sanctioned Skydio in retaliation for US approval of drone sales to Taiwan. Chinese authorities ordered Dongguan Poweramp, Skydio's sole battery supplier, to cut all ties, forcing Skydio to ration batteries until new suppliers are found, expected in spring 2025." ;
    prov:wasDerivedFrom <https://dronexl.co/2024/10/30/us-drone-maker-skydio-supply-chain-crisis-chinese-sanctions>,
        <https://pravda.com.ua/eng/news/2024/10/31/7482246> ;
    ns1:affects data:code_us_8507600090,
        data:code_us_8806920000 ;
    iof:classifiedBy data:eventscope_scope_the_named_companies_only,
        data:eventtype_targeted_sanctions ;
    iof:occursAt data:country_CN .

