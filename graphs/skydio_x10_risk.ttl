data:bom a iof:DesignSpecification ;
    rdfs:label "Skydio X10 public reconstruction BOM v0.2" ;
    dcterms:hasVersion "public-0.2" ;
    rdfs:comment "Bounded Skydio X10 reconstruction from Skydio datasheets and support pages, one supplier press release (Nidec), news reports of the October 2024 Chinese sanctions, and a U.S. customs ocean bill-of-lading snapshot (ImportYeti API, 2026-11-09). Structure: the product plus 18 items named in Skydio or supplier sources (one airframe item inferred); four image-sensor items and their makers come from a retailer listing (secondary). Suppliers: item-level associations only where a named source states them (NVIDIA, Qualcomm, Teledyne FLIR, Nidec, Sony and Samsung (retailer listing), Dongguan Poweramp (historical), Skydio final assembly); category-level associations for organisations that shipped goods to Skydio by sea on or after 2023-11-01 (X10 US shipping start), grouped by the goods in the customs descriptions. Customs records show goods shipped to Skydio, not which Skydio product they were for. Not a complete or certified production BOM; quantities only where a source states them; air freight and distributor purchases are not visible. Item-to-category classifications are researcher-derived and pending review. Every statement carries a status in the assertion audit. v0.2 adds 50 shipments (ocean bills arriving May to October 2026) and 12 port-to-port routes from bill-of-lading lookups; 36 shipments are allocated to an item through the supplier's customs-based category (researcher-derived), the rest (packaging, power supplies) to no item. Item-level supply links added for the sensor package and Connect SL radio (Skydio) and the 5G modem (Telit Cinterion). Item-level links with no customs record carry 15 modelled flows (observationStatus 'modelled', researcher-derived) from inferred or supplier-stated countries of manufacture; each origin site's evidence note gives the basis and confidence, and the Connect SL radio flow has no origin (not established)." ;
    prov:wasAttributedTo data:researcher ;
    iof:prescribes data:product .

data:cat_camera_modules_suppliers a iof:GroupOfSuppliers ;
    bfo:BFO_0000115 data:sup_primax_electronics ;
    iof:classifiedBy data:cat_camera_modules .

data:cat_li_ion_batteries_suppliers a iof:GroupOfSuppliers ;
    bfo:BFO_0000115 data:sup_atemitech,
        data:sup_celxpert_energy,
        data:sup_simplo_technology ;
    iof:classifiedBy data:cat_li_ion_batteries .

data:cat_packaging_suppliers a iof:GroupOfSuppliers ;
    bfo:BFO_0000115 data:sup_j_packaging_vina,
        data:sup_lichien_vietnam_paper_products,
        data:sup_super_bold_vietnam_packaging_prod ;
    iof:classifiedBy data:cat_packaging .

data:cat_power_supplies_suppliers a iof:GroupOfSuppliers ;
    bfo:BFO_0000115 data:sup_chicony_power_technology,
        data:sup_mean_well_international ;
    iof:classifiedBy data:cat_power_supplies .

data:cat_structural_parts_suppliers a iof:GroupOfSuppliers ;
    bfo:BFO_0000115 data:sup_fu_chia_metal_casting,
        data:sup_fuyu,
        data:sup_samkwang ;
    iof:classifiedBy data:cat_structural_parts .

